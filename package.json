{
  "name": "takomi-code",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:desktop": "node --import tsx/esm scripts/dev-desktop.mjs",
    "dev:web": "node --import tsx/esm scripts/dev-web.mjs",
    "dev:web-local": "node --import tsx/esm scripts/dev-web-local.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "verify:contracts": "node scripts/verify-contracts.mjs",
    "verify:session-bundle": "node scripts/verify-session-bundle.mjs",
    "verify:transcript-runtime-state": "node scripts/verify-transcript-runtime-state.mjs",
    "verify:desktop-runtime-ipc": "node --import tsx/esm scripts/verify-desktop-runtime-ipc.mjs",
    "verify:web-local-bridge": "node scripts/verify-web-local-bridge.mjs",
    "verify:persistence": "node --import tsx/esm scripts/verify-persistence.mjs",
    "verify:orchestration-engine": "node --import tsx/esm scripts/verify-orchestration-engine.mjs",
    "verify:worktree-controls": "node --import tsx/esm scripts/verify-worktree-controls.mjs",
    "verify:interventions-recovery": "node --import tsx/esm scripts/verify-interventions-recovery.mjs",
    "verify:settings-billing-bags": "node --import tsx/esm scripts/verify-settings-billing-bags.mjs",
    "lint": "node scripts/lint.mjs",
    "format": "node scripts/format.mjs",
    "verify": "python scripts/vibe-verify.py"
  },
  "devDependencies": {
    "@types/node": "^22.15.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "electron": "^35.1.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  }
}
