  "dependencies": {
    "@takomi/contracts": "workspace:*",
    "@takomi/orchestration": "workspace:*",
    "@takomi/persistence": "workspace:*",
    "@takomi/runtime-codex": "workspace:*",
    "@takomi/ui": "workspace:*",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  }
